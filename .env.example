# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_KNOWLEDGE_BASE_ID=your_knowledge_base_id
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# DynamoDB Tables
DYNAMODB_USERS_TABLE=aws-pricing-assistant-users
DYNAMODB_SESSIONS_TABLE=aws-pricing-assistant-sessions
DYNAMODB_QUOTES_TABLE=aws-pricing-assistant-quotes
DYNAMODB_CLOUD_SERVICES_TABLE=aws-pricing-assistant-cloud-services
DYNAMODB_MAPPING_CACHE_TABLE=aws-pricing-assistant-mapping-cache

# S3 Configuration
S3_BUCKET_NAME=aws-pricing-assistant-exports
S3_KNOWLEDGE_BASE_BUCKET=aws-pricing-assistant-kb-data

# Authentication
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=100  # requests per minute per user

# SSL/TLS Configuration
SSL_CERT_PATH=  # Path to SSL certificate file (e.g., /path/to/cert.pem)
SSL_KEY_PATH=  # Path to SSL private key file (e.g., /path/to/key.pem)
SSL_CA_BUNDLE_PATH=  # Optional: Path to CA bundle file
ENFORCE_HTTPS=true  # Set to false to disable HTTPS enforcement

# Data Encryption Configuration
DATA_ENCRYPTION_KEY=  # Base64-encoded encryption key for sensitive data (generate with scripts/generate_encryption_key.py)
S3_ENCRYPTION_TYPE=AES256  # S3 encryption type: AES256 or aws:kms
S3_KMS_KEY_ID=  # Optional: KMS key ID for S3 encryption (required if using aws:kms)

# CloudWatch Configuration
CLOUDWATCH_LOG_GROUP=/aws/pricing-assistant
CLOUDWATCH_LOG_STREAM=application

# Application Settings
ENVIRONMENT=development  # development, staging, production
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Web Crawler Configuration
CRAWLER_SCHEDULE=cron(0 2 * * ? *)  # Daily at 2 AM UTC
CRAWLER_USER_AGENT=AWS-Pricing-Assistant-Bot/1.0
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_RETRY_DELAY=5  # seconds
