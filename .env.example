# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here

# S3 Configuration
S3_KNOWLEDGE_BASE_BUCKET=aws-pricing-assistant-kb-data

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_KNOWLEDGE_BASE_ID=your-kb-id-here
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# DynamoDB Tables
DYNAMODB_USERS_TABLE=aws-pricing-assistant-users
DYNAMODB_SESSIONS_TABLE=aws-pricing-assistant-sessions
DYNAMODB_QUOTES_TABLE=aws-pricing-assistant-quotes
DYNAMODB_CLOUD_SERVICES_TABLE=aws-pricing-assistant-cloud-services
DYNAMODB_SERVICE_MAPPING_CACHE_TABLE=aws-pricing-assistant-service-mapping-cache

# S3 Buckets
S3_BUCKET_NAME=aws-pricing-assistant-exports

# Authentication
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=100

# CloudWatch Configuration
CLOUDWATCH_LOG_GROUP=/aws/pricing-assistant
CLOUDWATCH_LOG_STREAM=application

# Application Settings
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Web Crawler Configuration
CRAWLER_SCHEDULE=cron(0 2 * * ? *)
CRAWLER_USER_AGENT=AWS-Pricing-Assistant-Bot/1.0
CRAWLER_RETRY_ATTEMPTS=3
CRAWLER_RETRY_DELAY=5

